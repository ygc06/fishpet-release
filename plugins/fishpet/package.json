{
  "name": "@local/dsh-fishpet-emotion",
  "version": "0.9.14",
  "private": true,
  "type": "module",
  "description": "Unified DSH FishPet plugin: native emotion engine and dashboard plus the loopback bridge used by the standalone desktop companion.",
  "license": "UNLICENSED",
  "main": "src/unified.js",
  "exports": {
    ".": "./src/unified.js",
    "./emotion": "./src/index.js",
    "./bridge": "./src/bridge/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src/",
    "scripts/",
    "test/fixtures/",
    "cordis.patch.yml",
    "PERSONA.md",
    "README.md",
    "tsconfig.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "preview": "node scripts/preview.mjs"
  }
}
